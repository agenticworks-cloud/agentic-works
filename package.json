      "view/title": [
        {
          "command": "chirp.refresh",
          "when": "config.roost.teams.enabled && !roost.teams.failed && (view == chirp.sidebar)",
          "group": "navigation@1"
        },
        {
          "command": "chirp.signIn",
          "when": "config.roost.teams.enabled && !roost.teams.failed && (view == chirp.sidebar)",
          "group": "2_account@1"
        },
        {
          "command": "chirp.signOut",
          "when": "config.roost.teams.enabled && !roost.teams.failed && (view == chirp.sidebar)",
          "group": "2_account@2"
        },
        {
          "command": "jay.refresh",
          "when": "config.roost.jira.enabled && !roost.jira.failed && (view == jay.sidebar)",
          "group": "navigation@1"
        },
        {
          "command": "jay.signIn",
          "when": "config.roost.jira.enabled && !roost.jira.failed && (view == jay.sidebar)",
          "group": "2_account@1"
        },
        {
          "command": "jay.signOut",
          "when": "config.roost.jira.enabled && !roost.jira.failed && (view == jay.sidebar)",
          "group": "2_account@2"
        },
        {
          "command": "kestrel.refresh",
          "when": "config.roost.prs.enabled && !roost.prs.failed && (view == kestrel.prs)",
          "group": "navigation@1"
        },
        {
          "command": "perch.handoff",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
          "group": "1_new@5"
        },
        {
          "command": "perch.continueInCodex",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
