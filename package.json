{
  "name": "roost",
  "displayName": "Roost",
  "publisher": "seanahn",
  "version": "0.1.0",
  "description": "Claude Code and Codex tabs, Teams, Jira & Confluence and pull requests in one extension.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "MIT",
  "repository": "https://github.com/seanahn/roost",
  "icon": "parts/perch/media/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:chirp.conversation",
    "onWebviewPanel:jay.ticket",
    "onWebviewPanel:jay.page",
    "onWebviewPanel:perch.session"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chirp",
          "title": "Teams",
          "icon": "parts/chirp/media/teams-icon.svg"
        },
        {
          "id": "jay",
          "title": "Jira and Confluence",
          "icon": "parts/jay/media/jay-icon.svg"
        },
        {
          "id": "perch",
          "title": "Perch",
          "icon": "parts/perch/media/perch.svg"
        }
      ],
      "panel": [
        {
          "id": "kestrel",
          "title": "PRs",
          "icon": "parts/kestrel/media/pr.svg"
        }
      ]
    },
    "views": {
      "chirp": [
        {
          "type": "webview",
          "id": "chirp.sidebar",
          "name": "Chats and Channels",
          "when": "config.roost.teams.enabled && !roost.teams.failed"
        }
      ],
      "jay": [
        {
          "type": "webview",
          "id": "jay.sidebar",
          "name": "Jira",
          "when": "config.roost.jira.enabled && !roost.jira.failed"
        }
      ],
      "kestrel": [
        {
          "type": "webview",
          "id": "kestrel.prs",
          "name": "PRs",
          "when": "config.roost.prs.enabled && !roost.prs.failed"
        }
      ],
      "perch": [
        {
          "type": "webview",
          "id": "perch.main",
          "name": "Sessions",
          "when": "config.roost.perch.enabled && !roost.perch.failed"
        }
      ]
    },
    "commands": [
      {
        "command": "chirp.refresh",
        "title": "chirp: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "chirp.focusFilter",
        "title": "chirp: Filter Chats and Channels"
      },
      {
        "command": "chirp.activeConversationFile",
        "title": "chirp: Active Conversation File"
      },
      {
        "command": "chirp.signIn",
        "title": "chirp: Sign In",
        "icon": "$(sign-in)"
      },
      {
        "command": "chirp.signOut",
        "title": "chirp: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "chirp.enableChannels",
        "title": "chirp: Enable Channels"
      },
      {
        "command": "chirp.cancelSignIn",
        "title": "chirp: Cancel Sign-in"
      },
      {
        "command": "chirp.copyAdminLink",
        "title": "chirp: Copy the Admin Approval Link"
      },
      {
        "command": "chirp.copyCode",
        "title": "chirp: Copy Sign-in Code and Open the Sign-in Page"
      },
      {
        "command": "jay.refresh",
        "title": "jay: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "jay.signIn",
        "title": "jay: Sign In",
        "icon": "$(sign-in)"
      },
      {
        "command": "jay.signOut",
        "title": "jay: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "jay.focusSearch",
        "title": "jay: Search Tickets"
      },
      {
        "command": "jay.activeIssueFile",
        "title": "jay: Active Issue File"
      },
      {
        "command": "jay.openTicket",
        "title": "jay: Open Ticket"
      },
      {
        "command": "jay.projectKeys",
        "title": "jay: Project Keys"
      },
      {
        "command": "jay.openPage",
        "title": "jay: Open Confluence Page"
      },
      {
        "command": "jay.siteUrl",
        "title": "jay: Site URL"
      },
      {
        "command": "jay.activePageFile",
        "title": "jay: Active Page File"
      },
      {
        "command": "kestrel.refresh",
        "title": "kestrel: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kestrel.watch",
        "title": "kestrel: Watch"
      },
      {
        "command": "perch.open",
        "title": "Perch: Open",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "perch.newClaude",
        "title": "Perch: New Claude Tab",
        "icon": "$(add)"
      },
      {
        "command": "perch.newClaudeGateway",
        "title": "Perch: New Claude Tab on the Gateway",
        "icon": "$(add)"
      },
      {
        "command": "perch.newCodex",
        "title": "Perch: New Codex Tab",
        "icon": "$(add)"
      },
      {
        "command": "perch.stop",
        "title": "Perch: Stop Active Tab",
        "icon": "$(debug-stop)"
      },
      {
        "command": "perch.closeTab",
        "title": "Perch: Close Active Tab",
        "icon": "$(close)"
      },
      {
        "command": "perch.handoff",
        "title": "Perch: Hand Off Last Answer to Another Tab…",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "perch.insertText",
        "title": "Perch: Insert Text into the Active Tab"
      },
      {
        "command": "perch.notePrMerged",
        "title": "Perch: Note a Merged Pull Request in the Session That Made It"
      },
      {
        "command": "perch.findPrSession",
        "title": "Perch: Find the Session That Made a Pull Request"
      },
      {
        "command": "perch.openPrSession",
        "title": "Perch: Open the Session That Made a Pull Request"
      },
      {
        "command": "perch.continueInCodex",
        "title": "Perch: Continue This Tab in Codex…",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "perch.continueInClaude",
        "title": "Perch: Continue This Tab in Claude…",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "perch.sessions",
        "title": "Perch: Sessions…",
        "icon": "$(history)"
      },
      {
        "command": "perch.renameTab",
        "title": "Perch: Rename Active Tab…",
        "icon": "$(edit)"
      },
      {
        "command": "perch.refreshModels",
        "title": "Perch: Refresh Model Lists",
        "icon": "$(refresh)"
      },
      {
        "command": "perch.meter.refresh",
        "title": "Perch: Refresh Claude Usage"
      },
      {
        "command": "perch.meter.toggleBackend",
        "title": "Perch: Switch Claude Backend (Subscription / API)"
      },
      {
        "command": "perch.meter.login",
        "title": "Perch: Log in to Claude (subscription)"
      },
      {
        "command": "perch.new",
        "title": "Perch: New Tab…",
        "icon": "$(add)"
      },
      {
        "command": "perch.moveToEditor",
        "title": "Perch: Move Tab to the Editor Area",
        "icon": "$(open-preview)"
      },
      {
        "command": "perch.moveToSidebar",
        "title": "Perch: Move Tab to the Sidebar",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "perch.moveAllToEditor",
        "title": "Perch: Move All Tabs to the Editor Area"
      },
      {
        "command": "perch.moveAllToSidebar",
        "title": "Perch: Move All Tabs to the Sidebar"
      },
      {
        "command": "perch.codebaseIndex.toggle",
        "title": "Perch: Toggle Codebase Search"
      },
      {
        "command": "perch.codebaseIndex.install",
        "title": "Perch: Install Codebase Search by Meaning"
      },
      {
        "command": "perch.clearSecretExceptions",
        "title": "Perch: Clear Secret-Check Exceptions"
      },
      {
        "command": "perch.voice.setup",
        "title": "Perch: Set Up Voice Input"
      },
      {
        "command": "perch.voice.toggle",
        "title": "Perch: Start or Finish Dictation",
        "icon": "$(mic)"
      },
      {
        "command": "perch.voice.cancel",
        "title": "Perch: Discard Dictation"
      },
      {
        "command": "perch.voice.unload",
        "title": "Perch: Unload the Speech Model (frees its memory)"
      },
      {
        "command": "perch.codex.toggleBackend",
        "title": "Perch: Switch Codex Backend (ChatGPT / API key)"
      },
      {
        "command": "perch.codex.setApiKey",
        "title": "Perch: Set OpenAI API Key for Codex…"
      },
      {
        "command": "perch.codex.clearApiKey",
        "title": "Perch: Forget the OpenAI API Key for Codex"
      },
      {
        "command": "roost.openSettings",
        "title": "Roost: Settings",
        "icon": "$(gear)"
      }
    ],
