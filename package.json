          "group": "1_new@4"
        },
        {
          "command": "perch.newClaude",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
          "group": "1_new@1"
        },
        {
          "command": "perch.newClaudeGateway",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main && perch.gateway)",
          "group": "1_new@11"
        },
        {
          "command": "perch.newCodex",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
          "group": "1_new@2"
        },
        {
          "command": "perch.closeTab",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
