        },
        {
          "command": "perch.meter.refresh",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
          "group": "3_meter@2"
        },
        {
          "command": "perch.moveToEditor",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
          "group": "2_models@2"
        },
        {
          "command": "perch.moveAllToEditor",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (view == perch.main)",
          "group": "2_models@3"
        },
        {
          "command": "roost.openSettings",
          "when": "view == perch.main",
          "group": "navigation@99"
        }
      ],
      "editor/title": [
        {
          "command": "perch.new",
          "when": "config.roost.perch.enabled && !roost.perch.failed && (activeWebviewPanelId == 'perch.session')",
