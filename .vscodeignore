.git/**
**/test/**
**/docs/**
parts/*/node_modules/**
parts/*/*.vsix
parts/perch/audio/**
scripts/**
Makefile
**/Makefile
.superpowers/**
**/package-lock.json
**/.env
**/__pycache__/**
parts/*/.gitignore
parts/*/.vscodeignore
# The agents' programs are not packaged: hundreds of megabytes, and one platform's only. Perch runs the ones inside
# the vendors' own extensions (parts/perch/src/binaries.js).
node_modules/@anthropic-ai/claude-agent-sdk-*/**
node_modules/@openai/codex-linux-*/**
node_modules/@openai/codex-darwin-*/**
node_modules/@openai/codex-win32-*/**
node_modules/**/*.map
node_modules/**/*.md
node_modules/**/.github/**
# ...but the dependencies' licence files stay, some of which are .md. A `!` line beats every line above, so these
# leave the agents' programs (excluded above) out.
!node_modules/!(@anthropic-ai|@openai)/**/[Ll][Ii][Cc][Ee][Nn][CcSs][Ee]*
!node_modules/@anthropic-ai/!(claude-agent-sdk-*)/**/[Ll][Ii][Cc][Ee][Nn][CcSs][Ee]*
!node_modules/@openai/!(codex-linux-*|codex-darwin-*|codex-win32-*)/**/[Ll][Ii][Cc][Ee][Nn][CcSs][Ee]*
# read by the manifest build only (scripts/build-manifest.js), not at runtime
.gitignore
roost.json
roost.contributes.json
