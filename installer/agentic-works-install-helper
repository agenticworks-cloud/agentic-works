#!/usr/bin/env python3
"""agentic-works-install-helper: the JSON and SQLite edits the bash installer `agentic-works-install.sh` delegates to.

Each subcommand exits 0 when done, 2 when it skipped (reason on stdout), 1 on error.

Runs on Python 3.6 (RHEL 8's python3), stdlib only: typing's List/Optional rather than list[...] or X | None, no
`from __future__ import annotations`, subprocess.run without capture_output, no Path.unlink(missing_ok=).
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, List, Optional

EXIT_DONE, EXIT_ERROR, EXIT_SKIPPED = 0, 1, 2

WANTED_SETTINGS = {
    "chat.disableAIFeatures": True,
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.activityBar.location": "top",
}
# --codebase-search: the installer's question answered yes (default); added only when absent, like the rest
CODEBASE_SEARCH = {"agents.codebaseIndex.enabled": True}
# --teams-app <clientId>:<tenant>: a company's own Microsoft app for the Teams part's sign-in, added only when absent
TEAMS_APP_KEYS = ("teams.signIn.clientId", "teams.signIn.tenant")
GUID = r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}"
DOMAIN = r"(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"
TEAMS_APP = re.compile(r"^(%s):(%s|%s)$" % (GUID, GUID, DOMAIN))
PINNED_KEY = "workbench.activity.pinnedViewlets2"
LAYOUT_RECORD_KEY = "agenticWorks.installer.layoutWritten"  # in state.vscdb: the layout was written once; never again
SHOWN_VIEWLETS = [
    "workbench.view.explorer",
    "workbench.view.search",
    "workbench.view.extensions",
    "workbench.view.extension.perch",
    "workbench.view.extension.chirp",
    "workbench.view.extension.jay",
]
HIDDEN_VIEWLETS = [
    "workbench.view.scm",
    "workbench.view.debug",
    "workbench.view.testing",
    "workbench.view.extension.claude-sidebar",
    "workbench.view.extension.claude-sessions-sidebar",
]

# Claude Code's and Codex's "open" buttons, which they put on every editor's title bar (Get started included; Sean,
# 2026-11-25). Hidden as a right-click in the title bar would: VS Code keeps that per profile in state.vscdb, as
# {menu id: [command ids]}; there is no setting for it. Their diff buttons (accept, reject) are left alone.
HIDDEN_COMMANDS_KEY = "menu.hiddenCommands"
HIDDEN_TITLE_COMMANDS = ["claude-vscode.editor.openLast", "claude-vscode.terminal.open", "chatgpt.openSidebar"]


def hidden_commands(value: Optional[str]) -> Optional[str]:
    """menu.hiddenCommands with the vendor title buttons added to EditorTitle; None when the value isn't such JSON."""
    try:
        data = json.loads(value) if value else {}
    except ValueError:
        return None
    if not isinstance(data, dict) or not isinstance(data.get("EditorTitle", []), list):
        return None
    title = data.get("EditorTitle", [])
    data["EditorTitle"] = title + [c for c in HIDDEN_TITLE_COMMANDS if c not in title]
    return json.dumps(data)


def user_dir() -> Path:
    override = os.environ.get("AGENTIC_WORKS_VSCODE_USER_DIR")
    if override:
        return Path(override)
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "Code" / "User"
    return Path.home() / ".config" / "Code" / "User"


PROFILE = None  # type: Optional[str]  # --profile NAME: the VS Code profile the settings and layout go into


def _storage() -> Path:
    """VS Code's storage.json: its profiles (userDataProfiles) and its windows."""
    return user_dir() / "globalStorage" / "storage.json"


def _read_storage() -> dict:
    """storage.json as a dict ({} when absent); ValueError when it isn't a JSON object."""
    path = _storage()
    data = json.loads(path.read_text(encoding="utf-8") or "{}") if path.exists() else {}
    if not isinstance(data, dict) or not isinstance(data.get("userDataProfiles", []), list):
        raise ValueError(f"{path} isn't a JSON object of VS Code's")
    return data


def profile_location(name: str) -> Optional[str]:
    """The folder under User/profiles of the profile named name; None when there is none."""
    for entry in _read_storage().get("userDataProfiles", []):
        if isinstance(entry, dict) and entry.get("name") == name and isinstance(entry.get("location"), str):
            return entry["location"]
    return None


def target_dir() -> Path:
    """Where settings.json and globalStorage are: the --profile's folder, else the user's own. ValueError when that
    profile hasn't been made."""
    if PROFILE is None:
        return user_dir()
    location = profile_location(PROFILE)
    if location is None:
        raise ValueError(f"VS Code has no profile named {PROFILE!r}")
    return user_dir() / "profiles" / location


# Copied from the user's own profile into a new one, so it starts with their settings; extensions and state are not.
PROFILE_COPIES = ("settings.json", "keybindings.json", "tasks.json", "snippets")


def _blank(path: Path) -> bool:
    """A file with nothing in it: absent, empty, or {} or [] (what VS Code writes in a profile it makes)."""
    try:
        return not path.exists() or path.is_file() and path.read_text(encoding="utf-8").strip() in ("", "{}", "[]")
    except (OSError, UnicodeDecodeError):
        return False


def _copy_users_files(folder: Path) -> bool:
    """The user's settings, keybindings, tasks and snippets into a profile's folder, each only where the profile's
    is blank; True when any was copied."""
    copied = False
    for name in PROFILE_COPIES:
        source, dest = user_dir() / name, folder / name
        if source.is_dir() and not dest.exists():
            shutil.copytree(str(source), str(dest))
            copied = True
        elif source.is_file() and not _blank(source) and _blank(dest):
            shutil.copyfile(str(source), str(dest))
            copied = True
    return copied


def cmd_vscode_profile(args: argparse.Namespace) -> int:
    """Make the VS Code profile args.name, with the user's settings, keybindings and snippets copied in; one already
    there is left as it is. Not while VS Code runs: it rewrites storage.json from memory and the new profile would
    be lost (it makes its own, empty, when a window is opened on the name)."""
    try:
        data = _read_storage()
    except (ValueError, UnicodeDecodeError) as exc:
        print(f"agentic-works-install-helper: {exc}", file=sys.stderr)
        return EXIT_ERROR
    location = profile_location(args.name)
    if args.fill:
        if location is None:
            print(f"agentic-works-install-helper: VS Code has no profile named {args.name!r}", file=sys.stderr)
            return EXIT_ERROR
        print("filled" if _copy_users_files(user_dir() / "profiles" / location) else "already set")
        return EXIT_DONE
    if location is not None:
        print("already set")
        return EXIT_DONE
    if vscode_running():
        print("VS Code is running: it makes the profile itself when a window is opened on it.")
        return EXIT_SKIPPED
    taken = {e.get("location") for e in data.get("userDataProfiles", []) if isinstance(e, dict)}
    base = "agentic-works-" + hashlib.sha256(args.name.encode("utf-8")).hexdigest()[:8]
    location, n = base, 1
    while location in taken or (user_dir() / "profiles" / location).exists():
        n += 1
        location = f"{base}-{n}"
    folder = user_dir() / "profiles" / location
    folder.mkdir(parents=True)
    copied = _copy_users_files(folder)
    data["userDataProfiles"] = data.get("userDataProfiles", []) + [{"location": location, "name": args.name}]
    _write_atomic(_storage(), json.dumps(data, indent=4) + "\n")
    print("made, with your settings" if copied else "made")
    return EXIT_DONE


def extensions_dir() -> Path:
    override = os.environ.get("AGENTIC_WORKS_VSCODE_EXTENSIONS_DIR")
    return Path(override) if override else Path.home() / ".vscode" / "extensions"


def merge_settings(text: str, wanted: dict) -> Optional[str]:
    """Add the wanted keys that are absent; None when the text is not plain JSON (JSONC).

    When nothing is absent the text is returned unchanged, so callers can detect a no-op by equality.
    """
    if text.strip():
        try:
            data = json.loads(text)
        except ValueError:
            return None
        if not isinstance(data, dict):
            return None
    else:
        data = {}
    missing = {k: v for k, v in wanted.items() if k not in data}
    if not missing and text.strip():
        return text
    data.update(missing)
    return json.dumps(data, indent=4, ensure_ascii=False) + "\n"


def _write_atomic(path: Path, text: str) -> None:
    """Replace path with text via a private temp file; keeps the mode.

    A symlink is followed: its target is replaced and the link stays (a dotfiles repo's settings.json)."""
    path = Path(os.path.realpath(path))
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".agentic-works-tmp")
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    if path.exists():
        os.chmod(str(tmp), path.stat().st_mode & 0o7777)
    else:
        os.chmod(str(tmp), 0o644)
    os.replace(str(tmp), str(path))


def teams_app(value: str) -> Dict[str, str]:
    """`<clientId>:<tenant>` as the two Teams settings; the tenant is a GUID or a domain. ValueError when not."""
    match = TEAMS_APP.match(value.strip())
    if not match:
        raise ValueError("--teams-app takes <clientId>:<tenant>: a GUID, then a tenant GUID or domain")
    return dict(zip(TEAMS_APP_KEYS, (match.group(1).lower(), match.group(2).lower())))


def _has_any(text: str, keys: tuple) -> bool:
    """Whether plain-JSON settings text has any of the keys (JSONC: no, its lines are printed for the user to add)."""
    try:
        data = json.loads(text) if text.strip() else {}
    except ValueError:
        return False
    return isinstance(data, dict) and any(k in data for k in keys)


def cmd_vscode_settings(args: argparse.Namespace) -> int:
    """Merge the wanted keys into VS Code user settings.json without overwriting a key or rewriting JSONC."""
    path = target_dir() / "settings.json"
    wanted = dict(WANTED_SETTINGS)
    if args.codebase_search:
        wanted.update(CODEBASE_SEARCH)
    pair = {}  # type: Dict[str, str]
    if args.teams_app:
        try:
            pair = teams_app(args.teams_app)
        except ValueError as exc:
            print(f"agentic-works-install-helper: {exc}", file=sys.stderr)
            return EXIT_ERROR
    try:
        text = path.read_text(encoding="utf-8") if path.exists() else ""
        # the two go together: either already set keeps both as they are, so an app never meets another's tenant
        if pair and not _has_any(text, TEAMS_APP_KEYS):
            wanted.update(pair)
        merged = merge_settings(text, wanted)
    except UnicodeDecodeError:
        merged = None
    if merged is None:
        print(f"{path} has comments or is not plain UTF-8 JSON; not rewriting it. Add these lines yourself:")
        for key, value in wanted.items():
            print(f"    {json.dumps(key)}: {json.dumps(value)},")
        return EXIT_SKIPPED
    if merged == text:
        print("already set")
        return EXIT_DONE
    _write_atomic(path, merged)
    if args.codebase_search and "agents.codebaseIndex.enabled" not in json.loads(text.strip() or "{}"):
        print("codebase search added")  # the installer's cue for its hint; a value already there was kept
    return EXIT_DONE


def layout_entry(existing: List[Dict], hidden_extra: List[str]) -> List[Dict]:
    entry = [{"id": vid, "pinned": True, "visible": True, "order": i} for i, vid in enumerate(SHOWN_VIEWLETS)]
    hidden = HIDDEN_VIEWLETS + [vid for vid in hidden_extra if vid not in HIDDEN_VIEWLETS]
    entry += [{"id": vid, "pinned": False, "visible": False} for vid in hidden]
    managed = set(SHOWN_VIEWLETS) | set(hidden)
    entry += [e for e in existing if e.get("id") not in managed]
    return entry


def codex_container_ids() -> List[str]:
    """Activity-bar container ids of the installed openai.chatgpt extension, as workbench view ids."""
    ids = []  # type: List[str]
    root = extensions_dir()
    if not root.is_dir():
        return ids
    for pkg in sorted(root.glob("openai.chatgpt-*/package.json")):
        try:
            data = json.loads(pkg.read_text(encoding="utf-8"))
            containers = data["contributes"]["viewsContainers"]["activitybar"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
        for container in containers:
            cid = container.get("id") if isinstance(container, dict) else None
            if cid and f"workbench.view.extension.{cid}" not in ids:
                ids.append(f"workbench.view.extension.{cid}")
    return ids


def vscode_running() -> bool:
    """True while a VS Code runs on this user data directory: its code.lock names the main process, alive.

    Only that VS Code matters (it rewrites state.vscdb and storage.json on exit); another one, on another data
    directory, does not. A process scan skipped the layout whenever any VS Code was open (Sean's runs with a test
    home, 2026-11-24). No lock file: none runs here."""
    lock = user_dir().parent / "code.lock"
    try:
        pid = int(lock.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # alive, another user's
    return True


def _has_key(db: Path, key: str) -> bool:
    if not db.exists():
        return False
    try:
        con = sqlite3.connect(f"{db.as_uri()}?mode=ro", uri=True)
        try:
            return con.execute("SELECT 1 FROM ItemTable WHERE key = ?", (key,)).fetchone() is not None
        finally:
            con.close()
    except sqlite3.Error:
        return False


def layout_recorded(db: Path) -> bool:
    """True once this installer has written the layout into this state.vscdb (it is written only once)."""
    return _has_key(db, LAYOUT_RECORD_KEY)


def layout_needed(db: Path) -> bool:
    """True when VS Code never started here: state.vscdb is absent or holds no activity-bar layout."""
    return not _has_key(db, PINNED_KEY)


# VS Code's first window, maximized: a fresh install opens one about 60% of the screen, too narrow for the Get
# started walkthrough's detail column beside the side bar (Sean's first-time run, 2026-11-24). VS Code keeps the last
# window's state in storage.json; mode 0 is maximized, and the size is what un-maximizing returns to (VS Code ignores
# a state without one). Written with the layout, only on a VS Code that never started, and only when absent.
FIRST_WINDOW = {"lastActiveWindow": {"uiState": {"mode": 0, "x": 80, "y": 60, "width": 1440, "height": 900}}, "openedWindows": []}


def maximize_first_window(storage: Path) -> None:
    """Add windowsState to storage.json when it has none; a file that isn't a JSON object is left alone."""
    data = {}
    if storage.exists():
        try:
            data = json.loads(storage.read_text(encoding="utf-8") or "{}")
        except (ValueError, UnicodeDecodeError):
            return
        if not isinstance(data, dict) or "windowsState" in data:
            return
    data["windowsState"] = FIRST_WINDOW
    _write_atomic(storage, json.dumps(data, indent=4) + "\n")


def cmd_vscode_layout(_args: argparse.Namespace) -> int:
    """Write the activity-bar layout once, recorded in the same transaction; later runs, and a VS Code that
    already has a layout, are left alone."""
    db = target_dir() / "globalStorage" / "state.vscdb"
    if layout_recorded(db):
        print("already set")
        return EXIT_DONE
    if not layout_needed(db):
        print("VS Code already has an icon layout; leaving it as it is.")
        return EXIT_SKIPPED
    if vscode_running():
        print("VS Code is running: quit VS Code and rerun.")
        return EXIT_SKIPPED
    db.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(db))  # a Path only from 3.7
    try:
        con.execute("CREATE TABLE IF NOT EXISTS ItemTable (key TEXT UNIQUE ON CONFLICT REPLACE, value BLOB)")
        entry = layout_entry([], codex_container_ids())
        written = datetime.now(timezone.utc).isoformat(timespec="seconds")
        con.execute("INSERT INTO ItemTable (key, value) VALUES (?, ?)", (PINNED_KEY, json.dumps(entry)))
        row = con.execute("SELECT value FROM ItemTable WHERE key = ?", (HIDDEN_COMMANDS_KEY,)).fetchone()
        hidden = hidden_commands(row[0] if row else None)
        if hidden is not None:
            con.execute("INSERT INTO ItemTable (key, value) VALUES (?, ?)", (HIDDEN_COMMANDS_KEY, hidden))
        con.execute("INSERT INTO ItemTable (key, value) VALUES (?, ?)", (LAYOUT_RECORD_KEY, written))
        con.commit()
    finally:
        con.close()
    maximize_first_window(_storage())  # the app's windows: storage.json is the user's own, whatever the profile
    return EXIT_DONE


NO_ONBOARDING = {"workbench.welcomePage.experimentalOnboarding": False}


def cmd_vscode_no_onboarding(_args: argparse.Namespace) -> int:
    """VS Code's first-launch welcome (its Copilot sign-in) off, in the user's own settings.json, whatever --profile.

    The setting is application-wide, so VS Code reads it only from there. With VS Code open, the window that makes a
    profile starts before the profile has its settings (Copilot off among them), and on VS Code's very first launch it
    showed the welcome (2026-11-27). A value there is kept; JSONC is left alone."""
    path = user_dir() / "settings.json"
    try:
        text = path.read_text(encoding="utf-8") if path.exists() else ""
        merged = merge_settings(text, NO_ONBOARDING)
    except UnicodeDecodeError:
        merged = None
    if merged is None:
        print(f"{path} has comments or is not plain UTF-8 JSON; not rewriting it")
        return EXIT_SKIPPED
    if merged == text:
        print("already set")
        return EXIT_DONE
    _write_atomic(path, merged)
    print("added")
    return EXIT_DONE


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agentic-works-install-helper", description=__doc__)
    parser.add_argument("--profile", metavar="NAME", help="the VS Code profile the settings and layout go into")
    sub = parser.add_subparsers(dest="command")
    sub.required = True  # add_subparsers(required=) is 3.7+
    settings = sub.add_parser("vscode-settings", help="merge Agentic Works' keys into VS Code user settings.json")
    settings.add_argument("--codebase-search", action="store_true", help="also turn on the agents' codebase search")
    settings.add_argument("--teams-app", metavar="CLIENT_ID:TENANT",
                          help="also set the Teams sign-in's company app (teams.signIn.clientId and .tenant)")
    settings.set_defaults(func=cmd_vscode_settings)
    sub.add_parser("vscode-layout", help="write the activity-bar layout into state.vscdb").set_defaults(
        func=cmd_vscode_layout
    )
    sub.add_parser("vscode-no-onboarding", help="turn VS Code's first-launch welcome off in the user's own settings.json"
                   ).set_defaults(func=cmd_vscode_no_onboarding)
    made = sub.add_parser("vscode-profile", help="make a VS Code profile, with the user's settings copied in")
    made.add_argument("name")
    made.add_argument("--fill", action="store_true",
                      help="copy the user's settings into the profile, already made, where its own are blank")
    made.set_defaults(func=cmd_vscode_profile)
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    global PROFILE
    args = build_parser().parse_args(argv)
    PROFILE = args.profile
    try:
        return args.func(args)
    except (OSError, sqlite3.Error, ValueError) as exc:
        print(f"agentic-works-install-helper: {exc}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
