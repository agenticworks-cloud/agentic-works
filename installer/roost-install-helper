#!/usr/bin/env python3
"""roost-install-helper: the JSON and SQLite edits the bash installer `roost-install.sh` delegates to.

Each subcommand exits 0 when done, 2 when it skipped (reason on stdout), 1 on error.

Runs on Python 3.6 (RHEL 8's python3), stdlib only: typing's List/Optional rather than list[...] or X | None, no
`from __future__ import annotations`, subprocess.run without capture_output, no Path.unlink(missing_ok=).
"""

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, List, Optional

EXIT_DONE, EXIT_ERROR, EXIT_SKIPPED = 0, 1, 2

WANTED_SETTINGS = {
    "chat.disableAIFeatures": True,
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.activityBar.location": "top",
}
# --codebase-search: the installer's question answered yes (default); added only when absent, like the rest
CODEBASE_SEARCH = {"agents.codebaseIndex.enabled": True}
# --teams-app <clientId>:<tenant>: a company's own Microsoft app for the Teams part's sign-in, added only when absent
TEAMS_APP_KEYS = ("teams.signIn.clientId", "teams.signIn.tenant")
GUID = r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}"
DOMAIN = r"(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"
TEAMS_APP = re.compile(r"^(%s):(%s|%s)$" % (GUID, GUID, DOMAIN))
PINNED_KEY = "workbench.activity.pinnedViewlets2"
LAYOUT_RECORD_KEY = "roost.installer.layoutWritten"  # in state.vscdb: the layout was written once; never again
SHOWN_VIEWLETS = [
    "workbench.view.explorer",
    "workbench.view.search",
    "workbench.view.extensions",
    "workbench.view.extension.perch",
    "workbench.view.extension.chirp",
    "workbench.view.extension.jay",
]
HIDDEN_VIEWLETS = [
    "workbench.view.scm",
    "workbench.view.debug",
    "workbench.view.testing",
    "workbench.view.extension.claude-sidebar",
    "workbench.view.extension.claude-sessions-sidebar",
]


def user_dir() -> Path:
    override = os.environ.get("ROOST_VSCODE_USER_DIR")
    if override:
        return Path(override)
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "Code" / "User"
    return Path.home() / ".config" / "Code" / "User"


def extensions_dir() -> Path:
    override = os.environ.get("ROOST_VSCODE_EXTENSIONS_DIR")
    return Path(override) if override else Path.home() / ".vscode" / "extensions"


def merge_settings(text: str, wanted: dict) -> Optional[str]:
    """Add the wanted keys that are absent; None when the text is not plain JSON (JSONC).

    When nothing is absent the text is returned unchanged, so callers can detect a no-op by equality.
    """
    if text.strip():
        try:
            data = json.loads(text)
        except ValueError:
            return None
        if not isinstance(data, dict):
            return None
    else:
        data = {}
    missing = {k: v for k, v in wanted.items() if k not in data}
    if not missing and text.strip():
        return text
    data.update(missing)
    return json.dumps(data, indent=4, ensure_ascii=False) + "\n"


def _write_atomic(path: Path, text: str) -> None:
    """Replace path with text via a private temp file; keeps the mode.

    A symlink is followed: its target is replaced and the link stays (a dotfiles repo's settings.json)."""
    path = Path(os.path.realpath(path))
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".roost-tmp")
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    if path.exists():
        os.chmod(str(tmp), path.stat().st_mode & 0o7777)
    else:
        os.chmod(str(tmp), 0o644)
    os.replace(str(tmp), str(path))


def teams_app(value: str) -> Dict[str, str]:
    """`<clientId>:<tenant>` as the two Teams settings; the tenant is a GUID or a domain. ValueError when not."""
    match = TEAMS_APP.match(value.strip())
    if not match:
        raise ValueError("--teams-app takes <clientId>:<tenant>: a GUID, then a tenant GUID or domain")
    return dict(zip(TEAMS_APP_KEYS, (match.group(1).lower(), match.group(2).lower())))


def _has_any(text: str, keys: tuple) -> bool:
    """Whether plain-JSON settings text has any of the keys (JSONC: no, its lines are printed for the user to add)."""
    try:
        data = json.loads(text) if text.strip() else {}
    except ValueError:
        return False
    return isinstance(data, dict) and any(k in data for k in keys)


def cmd_vscode_settings(args: argparse.Namespace) -> int:
    """Merge the wanted keys into VS Code user settings.json without overwriting a key or rewriting JSONC."""
    path = user_dir() / "settings.json"
    wanted = dict(WANTED_SETTINGS)
    if args.codebase_search:
        wanted.update(CODEBASE_SEARCH)
    pair = {}  # type: Dict[str, str]
    if args.teams_app:
        try:
            pair = teams_app(args.teams_app)
        except ValueError as exc:
            print(f"roost-install-helper: {exc}", file=sys.stderr)
            return EXIT_ERROR
    try:
        text = path.read_text(encoding="utf-8") if path.exists() else ""
        # the two go together: either already set keeps both as they are, so an app never meets another's tenant
        if pair and not _has_any(text, TEAMS_APP_KEYS):
            wanted.update(pair)
        merged = merge_settings(text, wanted)
    except UnicodeDecodeError:
        merged = None
    if merged is None:
        print(f"{path} has comments or is not plain UTF-8 JSON; not rewriting it. Add these lines yourself:")
        for key, value in wanted.items():
            print(f"    {json.dumps(key)}: {json.dumps(value)},")
        return EXIT_SKIPPED
    if merged == text:
        print("already set")
        return EXIT_DONE
    _write_atomic(path, merged)
    if args.codebase_search and "agents.codebaseIndex.enabled" not in json.loads(text.strip() or "{}"):
        print("codebase search added")  # the installer's cue for its hint; a value already there was kept
    return EXIT_DONE


def layout_entry(existing: List[Dict], hidden_extra: List[str]) -> List[Dict]:
    entry = [{"id": vid, "pinned": True, "visible": True, "order": i} for i, vid in enumerate(SHOWN_VIEWLETS)]
    hidden = HIDDEN_VIEWLETS + [vid for vid in hidden_extra if vid not in HIDDEN_VIEWLETS]
    entry += [{"id": vid, "pinned": False, "visible": False} for vid in hidden]
    managed = set(SHOWN_VIEWLETS) | set(hidden)
    entry += [e for e in existing if e.get("id") not in managed]
    return entry


def codex_container_ids() -> List[str]:
    """Activity-bar container ids of the installed openai.chatgpt extension, as workbench view ids."""
    ids = []  # type: List[str]
    root = extensions_dir()
    if not root.is_dir():
        return ids
    for pkg in sorted(root.glob("openai.chatgpt-*/package.json")):
        try:
            data = json.loads(pkg.read_text(encoding="utf-8"))
            containers = data["contributes"]["viewsContainers"]["activitybar"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
        for container in containers:
            cid = container.get("id") if isinstance(container, dict) else None
            if cid and f"workbench.view.extension.{cid}" not in ids:
                ids.append(f"workbench.view.extension.{cid}")
    return ids


def vscode_running_argv() -> List[str]:
    uid = str(os.getuid())
    if sys.platform == "darwin":
        return ["pgrep", "-u", uid, "-f", "Visual Studio Code.app/Contents/MacOS/"]
    return ["pgrep", "-x", "-u", uid, "code"]


def vscode_running() -> bool:
    try:
        result = subprocess.run(vscode_running_argv(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except FileNotFoundError:
        return False
    return result.returncode == 0


def _has_key(db: Path, key: str) -> bool:
    if not db.exists():
        return False
    try:
        con = sqlite3.connect(f"{db.as_uri()}?mode=ro", uri=True)
        try:
            return con.execute("SELECT 1 FROM ItemTable WHERE key = ?", (key,)).fetchone() is not None
        finally:
            con.close()
    except sqlite3.Error:
        return False


def layout_recorded(db: Path) -> bool:
    """True once this installer has written the layout into this state.vscdb (it is written only once)."""
    return _has_key(db, LAYOUT_RECORD_KEY)


def layout_needed(db: Path) -> bool:
    """True when VS Code never started here: state.vscdb is absent or holds no activity-bar layout."""
    return not _has_key(db, PINNED_KEY)


def cmd_vscode_layout(_args: argparse.Namespace) -> int:
    """Write the activity-bar layout once, recorded in the same transaction; later runs, and a VS Code that
    already has a layout, are left alone."""
    db = user_dir() / "globalStorage" / "state.vscdb"
    if layout_recorded(db):
        print("already set")
        return EXIT_DONE
    if not layout_needed(db):
        print("VS Code already has an icon layout; leaving it as it is.")
        return EXIT_SKIPPED
    if vscode_running():
        print("VS Code is running: quit VS Code and rerun.")
        return EXIT_SKIPPED
    db.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(db))  # a Path only from 3.7
    try:
        con.execute("CREATE TABLE IF NOT EXISTS ItemTable (key TEXT UNIQUE ON CONFLICT REPLACE, value BLOB)")
        entry = layout_entry([], codex_container_ids())
        written = datetime.now(timezone.utc).isoformat(timespec="seconds")
        con.execute("INSERT INTO ItemTable (key, value) VALUES (?, ?)", (PINNED_KEY, json.dumps(entry)))
        con.execute("INSERT INTO ItemTable (key, value) VALUES (?, ?)", (LAYOUT_RECORD_KEY, written))
        con.commit()
    finally:
        con.close()
    return EXIT_DONE


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="roost-install-helper", description=__doc__)
    sub = parser.add_subparsers(dest="command")
    sub.required = True  # add_subparsers(required=) is 3.7+
    settings = sub.add_parser("vscode-settings", help="merge Roost's keys into VS Code user settings.json")
    settings.add_argument("--codebase-search", action="store_true", help="also turn on the agents' codebase search")
    settings.add_argument("--teams-app", metavar="CLIENT_ID:TENANT",
                          help="also set the Teams sign-in's company app (teams.signIn.clientId and .tenant)")
    settings.set_defaults(func=cmd_vscode_settings)
    sub.add_parser("vscode-layout", help="write the activity-bar layout into state.vscdb").set_defaults(
        func=cmd_vscode_layout
    )
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except (OSError, sqlite3.Error) as exc:
        print(f"roost-install-helper: {exc}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
